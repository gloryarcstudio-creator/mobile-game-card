<Project Sdk="Microsoft.NET.Sdk">
  <!-- Тесты Fitil.Core без Unity: dotnet run, проект unity/Tests/Core.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core собирается из тех же файлов, что и в Unity (C# 9, без UnityEngine) -->
    <Compile Include="../../Assets/Fitil/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
